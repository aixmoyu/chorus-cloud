{
  "$schema": "../config.schema.json",
  "name": "VLESS Reality Vision",
  "version": "1.0.0",
  "params": [
    { "name": "domain", "type": "string", "required": true, "description": "Server address" },
    { "name": "port", "type": "number", "default": 443, "description": "Listen port" },
    { "name": "tag", "type": "string", "description": "Config tag (auto-generated if left empty)", "generator": "random_tag:vless" },
    { "name": "uuid", "type": "string", "description": "VLESS UUID", "generator": "uuid" },
    { "name": "realityServerName", "type": "string", "default": "learn.microsoft.com", "description": "Reality server name" },
    { "name": "realityKeyPair", "type": "object", "description": "Reality key pair (auto-generated)", "generator": "x25519_keypair" },
    { "name": "realityShortID", "type": "string", "description": "Reality short ID (auto-generated)", "generator": "hex:8" },
    { "name": "domainStrategy", "type": "string", "default": "prefer_ipv4", "description": "Domain strategy" }
  ],
  "description": "VLESS protocol with Reality TLS and Vision flow"
}
